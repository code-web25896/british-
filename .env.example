# ==========================================
# CONFIGURATION HOSTINGER NODE.JS
# ==========================================

# Environnement d'exécution (production ou development)
NODE_ENV=production

# Port d'écoute du serveur Node.js (Hostinger peut injecter cette variable automatiquement)
PORT=3000

# URL publique de votre domaine sur Hostinger (ex: https://votre-domaine.com)
APP_URL=https://votre-domaine.com

# GEMINI_API_KEY: Clé API Google Gemini (optionnel - si vous activez les fonctionnalités d'IA)
GEMINI_API_KEY=
